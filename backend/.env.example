# 数据库连接串：设置 CLIENTGET_DEV_DATABASE_URL 后自动派生 DATABASE_URL / SYNC_DATABASE_URL
CLIENTGET_DEV_DATABASE_URL=postgresql://user:pass@host:5432/dbname
CLIENTGET_PROD_DATABASE_URL=postgresql://user:pass@host:port/clientget

# 必填秘钥（无默认值，缺失时启动报错）
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
DATA_SOURCE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
INTERNAL_SERVICE_SECRET=change-me
ENGAGELAB_WEBHOOK_SECRET=change-me

# EngageLab 邮件服务（生产必填）
ENGAGELAB_BASE_URL=https://email.api.engagelab.cc
ENGAGELAB_API_USER=
ENGAGELAB_CREDENTIAL=

# 可选：生产环境 CORS 白名单（开发环境自动追加 localhost）
# ALLOWED_ORIGINS=https://admin.example.com,https://tenant.example.com

# 行业动态抓取循环：默认关闭；只在配置了动态源种子的实例（Instance A）打开；每天北京时间 INDUSTRY_NEWS_FETCH_HOUR_BEIJING 点跑一轮
# INDUSTRY_NEWS_FETCH_ENABLED=false
# INDUSTRY_NEWS_FETCH_HOUR_BEIJING=8
