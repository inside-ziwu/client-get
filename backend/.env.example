APP_NAME=ClientGet Backend
APP_ENV=local
DEBUG=true
API_V1_STR=/api/v1
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# DATABASE_URL / SYNC_DATABASE_URL 由根目录 .env 的 CLIENTGET_DEV_DATABASE_URL 自动派生
# 如需覆盖可手动设置：
# DATABASE_URL=postgresql+asyncpg://...
# SYNC_DATABASE_URL=postgresql+psycopg://...
DOCKER_APP_ENV=production
DOCKER_DEBUG=false
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/clientget
DOCKER_SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/clientget
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4173,http://localhost:4174,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:4173,http://127.0.0.1:4174,https://client-get-admin.vercel.app,https://client-get-tenant.vercel.app
DATA_SOURCE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
INTERNAL_SERVICE_SECRET=change-me-internal
ENGAGELAB_WEBHOOK_SECRET=change-me-webhook
ENGAGELAB_BASE_URL=https://email.api.engagelab.cc
ENGAGELAB_SEND_PATH=/v1/mail/send
ENGAGELAB_API_USER=
ENGAGELAB_CREDENTIAL=
ENGAGELAB_API_KEY=
ENGAGELAB_AUTH_HEADER=Authorization
ENGAGELAB_AUTH_SCHEME=Bearer
ENGAGELAB_TIMEOUT_SECONDS=10
COLLECTION_SCHEDULER_SLEEP_SECONDS=30
COLLECTION_WORKER_SLEEP_SECONDS=10
COLLECTION_TASK_LEASE_SECONDS=300
COLLECTION_WORKER_LIMIT=20
COLLECTION_HEARTBEAT_INTERVAL_SECONDS=30
