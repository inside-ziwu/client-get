// ClientGet 数据库结构总览（机器生成，请勿手改；工具 backend/scripts/schema_snapshot.py）
// 可整体粘贴到 https://dbdiagram.io 生成 ER 图。分区表在此视为普通表。

Project clientget {
  database_type: 'PostgreSQL'
}

Table ai_models {
  "id" UUID [pk, not null]
  "provider" VARCHAR(50) [not null]
  "model_id" VARCHAR(150) [not null]
  "display_name" VARCHAR(100) [not null]
  "is_active" BOOLEAN [not null]
  "config" JSONB [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "instance_id" VARCHAR [not null]
  Note: '平台级 AI 模型目录（按 instance_id 隔离）。平台管理员在 admin 配置页维护；场景默认映射与 AI 调用按此选择模型。'
}

Table ai_scene_defaults {
  "id" UUID [pk, not null]
  "scene" VARCHAR(40) [not null]
  "model_id" UUID [not null]
  "config" JSONB [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "instance_id" VARCHAR [not null]
  Note: 'AI 业务场景到默认模型的映射，每场景一行。平台管理员整表 PUT 维护；业务侧按场景取默认模型（要求模型启用中，否则报未配置）。'
}

Table ai_usage_logs {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "user_id" UUID
  "model_id" UUID [not null]
  "usage_type" VARCHAR(40) [not null]
  "entity_type" VARCHAR(50)
  "entity_id" UUID
  "input_tokens" INTEGER [not null]
  "output_tokens" INTEGER [not null]
  "total_tokens" INTEGER [not null]
  "estimated_cost" NUMERIC(12,4)
  "actual_cost" NUMERIC(12,4)
  "status" VARCHAR(20) [not null]
  "provider_response" JSONB
  "idempotency_key" VARCHAR(200)
  "provider_request_id" VARCHAR(200)
  "latency_ms" INTEGER
  "error_code" VARCHAR(100)
  "error_message" TEXT
  "created_at" TIMESTAMPTZ [not null]
  Note: 'AI 调用用量与成本流水，先建 pending 再收尾为 completed/failed。AI 功能（邮件生成、情报摘要）经 AiUsageLogService 写入；租户端用量汇总与 30 天趋势按 completed 记录统计。'
}

Table audit_logs {
  "id" UUID [not null]
  "tenant_id" UUID
  "user_id" UUID
  "platform_user_id" UUID
  "action" VARCHAR(30) [not null]
  "entity_type" VARCHAR(50) [not null]
  "entity_id" UUID
  "old_value" JSONB
  "new_value" JSONB
  "ip_address" INET
  "user_agent" TEXT
  "request_id" VARCHAR(100)
  "created_at" TIMESTAMPTZ [not null]
  indexes {
    (id, created_at) [pk]
  }
  Note: '平台与租户操作审计流水，按 created_at 月度分区（maintain_partitions.py 预建）。各服务在配置、团队、模板等变更时写入；当前无查询端点，只写不读。'
}

Table company_blacklist {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "shared_company_id" UUID
  "match_domain" VARCHAR(255)
  "match_name_pattern" VARCHAR(500)
  "reason" TEXT [not null]
  "blocked_by" UUID
  "created_at" TIMESTAMPTZ [not null]
  Note: '租户级公司黑名单：租户在客户池拉黑公司时写入快照，发送计划筛选收件人时按公司 ID、域名、名称三种方式匹配排除，命中即标记 blacklisted。'
}

Table company_scores {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "tenant_company_id" BIGINT [not null]
  "template_id" UUID [not null]
  "template_version_id" UUID [not null]
  "total_score" NUMERIC(5,2) [not null]
  "grade" CHAR(1) [not null]
  "dimension_scores" JSONB [not null]
  "llm_pending" BOOLEAN [not null]
  "llm_score" NUMERIC(5,2)
  "llm_reasoning" TEXT
  "llm_model_id" UUID
  "llm_usage_log_id" UUID
  "is_retry" BOOLEAN [not null]
  "retry_count" INTEGER [not null]
  "related_score_id" UUID
  "scored_at" TIMESTAMPTZ [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '公司评分结果表：确定性规则引擎（非 AI）按租户激活模板+版本对公司打分并 upsert（非重试行按 公司+模板版本 唯一）。入群组、平台模板同步、lineage 补评时写入；公司列表读 grade/total_score 作为 system_grade/system_score。'
}

Table contact_rules {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "name" VARCHAR(200) [not null]
  "is_active" BOOLEAN [not null]
  "rules" JSONB [not null]
  "version" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户联系人挑选策略配置：租户创建时播种一条默认规则（等级优先、要求有效邮箱），设置页读取与更新。partial unique index 保证每租户仅一条激活规则；当前无发送侧代码消费该配置。'
}

Table countries {
  "iso3" CHAR(3) [pk, not null]
  "name_zh" TEXT [not null]
  "name_en" TEXT [not null]
  "timezone" TEXT [not null]
  "rule_set_id" UUID
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '国家基础表（ISO3 主键）：收件人国家到 IANA 时区与工作时间规则集的映射，发送窗口计算的数据源；迁移种子初始化，admin 维护。'
}

Table country_holidays {
  "id" UUID [pk, not null]
  "country_iso3" CHAR(3) [not null]
  "date" DATE [not null]
  "name" TEXT
  "source" VARCHAR(20) [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '国家假日表：发送窗口计算时跳过收件人当地假日并顺延到下个可发时点；迁移种子 2026 年数据加 admin 手工维护，(国家,日期) 唯一。'
}

Table crawl_progress {
  "id" INTEGER [pk, not null]
  "source" TEXT [not null]
  "keyword_master_id" UUID [not null]
  "task_key" TEXT [not null]
  "status" TEXT
  "current_page" INTEGER
  "total_pages" INTEGER
  "total_records" INTEGER
  "extra" JSONB
  "created_at" TIMESTAMP
  "updated_at" TIMESTAMP
  Note: '外部采集程序的关键词分页进度断点表，(source, keyword_master_id, task_key) 唯一；迁移 0054 曾以「未使用」删除，后由外部程序重建（生产约 2.3 万行），仓库代码不读写。'
}

Table domain_daily_usage {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "domain_id" UUID [not null]
  "usage_date" DATE [not null]
  "daily_limit" INTEGER [not null]
  "reserved_count" INTEGER [not null]
  "sent_count" INTEGER [not null]
  "failed_count" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '域名 × 北京日历日的发送配额账本：worker 领取邮件前原子占位（不超 daily_limit），失败/推迟/僵尸回收时回退；(domain_id,usage_date) 唯一，占满即当日停领。'
}

Table domain_warmup_history {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "warmup_status_id" UUID [not null]
  "domain" VARCHAR(255) [not null]
  "warmup_level" INTEGER [not null]
  "daily_limit" INTEGER [not null]
  "total_sent" INTEGER [not null]
  "bounce_rate" NUMERIC(5,4)
  "complaint_rate" NUMERIC(5,4)
  "open_rate" NUMERIC(5,4)
  "change_type" VARCHAR(20) [not null]
  "change_reason" TEXT
  "changed_by" UUID
  "snapshot_at" TIMESTAMPTZ [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '域名预热变更与快照流水：记录建域、验证通过、调档等时点的档位与指标快照；admin 动作写入，租户端只读历史列表。'
}

Table domain_warmup_status {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "domain" VARCHAR(255) [not null]
  "spf_record" TEXT
  "dkim_record" TEXT
  "dmarc_record" TEXT
  "verification_status" VARCHAR(20) [not null]
  "dns_verified_at" TIMESTAMPTZ
  "dns_last_checked_at" TIMESTAMPTZ
  "warmup_rule_id" UUID
  "warmup_level" INTEGER [not null]
  "daily_limit" INTEGER [not null]
  "total_sent" INTEGER [not null]
  "bounce_rate" NUMERIC(5,4)
  "complaint_rate" NUMERIC(5,4)
  "open_rate" NUMERIC(5,4)
  "level_changed_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "sender_email" VARCHAR(255)
  Note: '租户发信域名档案：DNS 验证状态+预热档位与日配额，(tenant_id,domain) 唯一；admin 后台维护，发送链路读它校验域名可用、取发件地址、生成当日配额行。'
}

Table email_events {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "email_id" UUID [not null]
  "email_created_at" TIMESTAMPTZ [not null]
  "event_type" VARCHAR(20) [not null]
  "metadata" JSONB [not null]
  "source" VARCHAR(20) [not null]
  "provider_event_id" TEXT
  "occurred_at" TIMESTAMPTZ [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: 'EngageLab webhook 回传的投递事件流水：原始 payload 存档并幂等去重，是 emails 状态回写的依据；webhook 端点验签后写入。'
}

Table email_send_locks {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "enrollment_id" UUID [not null]
  "step_id" UUID [not null]
  "status" VARCHAR(20) [not null]
  "locked_by" VARCHAR(100)
  "locked_at" TIMESTAMPTZ [not null]
  "released_at" TIMESTAMPTZ
  "email_id" UUID
  "email_created_at" TIMESTAMPTZ
  Note: '(enrollment,step) 粒度的发送幂等锁，保证同一序列步骤至多成功发送一次——「不重复发送」的落库机制；worker 领取时抢锁并按结果流转，locked 超 30 分钟按僵尸锁回收。'
}

Table email_templates {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "source_type" VARCHAR(20) [not null]
  "platform_template_id" UUID
  "name" VARCHAR(200) [not null]
  "category" VARCHAR(50) [not null]
  "subject" TEXT [not null]
  "body_html" TEXT [not null]
  "body_text" TEXT
  "variables" JSONB [not null]
  "is_ai_generated" BOOLEAN [not null]
  "ai_prompt" TEXT
  "deleted_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户自有邮件模板：序列步骤（sequence_steps.template_id）发信时渲染其主题与正文，{{变量}} 替换后经清洗发出。来源为手写、AI 生成或平台模板复制；软删除（deleted_at）。'
}

Table emails {
  "id" UUID [not null]
  "tenant_id" UUID [not null]
  "plan_id" UUID
  "step_id" UUID
  "step_number" INTEGER
  "template_id" UUID
  "enrollment_id" UUID
  "tenant_contact_id" BIGINT [not null]
  "from_email" VARCHAR(255) [not null]
  "from_name" VARCHAR(200)
  "to_email" VARCHAR(255) [not null]
  "to_name" VARCHAR(200)
  "subject" TEXT [not null]
  "body_html" TEXT [not null]
  "body_text" TEXT
  "reply_message_id" VARCHAR(200)
  "reply_from_email" VARCHAR(255)
  "reply_subject" TEXT
  "reply_body_text" TEXT
  "reply_received_at" TIMESTAMPTZ
  "status" VARCHAR(20) [not null]
  "is_ai_personalized" BOOLEAN [not null]
  "ai_usage_log_id" UUID
  "engagelab_message_id" VARCHAR(100)
  "scheduled_at" TIMESTAMPTZ
  "sent_at" TIMESTAMPTZ
  "delivered_at" TIMESTAMPTZ
  "opened_at" TIMESTAMPTZ
  "clicked_at" TIMESTAMPTZ
  "replied_at" TIMESTAMPTZ
  "bounced_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "first_opened_at" TIMESTAMPTZ
  "open_count" INTEGER [not null]
  "soft_bounce" BOOLEAN [not null]
  "invalid_email" BOOLEAN [not null]
  "report_spam" BOOLEAN [not null]
  "unsubscribed" BOOLEAN [not null]
  indexes {
    (id, created_at) [pk]
  }
  Note: '每次实际发送的邮件实体：渲染消毒后的内容快照+投递全程状态；按 created_at 月度分区，复合主键 (id,created_at)。worker 领取时创建并发送，webhook 与对账 worker 回写状态，配额推迟时整行删除待重建。'
}

Table group_members {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "group_id" UUID [not null]
  "tenant_company_id" BIGINT [not null]
  "tenant_contact_id" BIGINT
  "added_by" VARCHAR(10) [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '分组成员表：一行代表组内一家公司及其选定的默认收件联系人，(group_id, tenant_company_id) 唯一。加/移成员时联动公司 business_status（in_group/new）。'
}

Table groups {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "name" VARCHAR(200) [not null]
  "description" TEXT
  "auto_rules" JSONB
  "member_count" INTEGER [not null]
  "deleted_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户客户分组（营销名单）：发送计划 recipient_source=’group’ 时作为收件人来源。租户在客户池维护，加组同时把公司 business_status 置为 in_group，软删除。'
}

Table industry_news_items {
  "id" UUID [pk, not null]
  "instance_id" VARCHAR [not null]
  "source_id" UUID [not null]
  "title" VARCHAR(500) [not null]
  "url" TEXT [not null]
  "canonical_url" TEXT [not null]
  "dedup_key" VARCHAR(40) [not null]
  "published_at" TIMESTAMPTZ
  "fetched_at" TIMESTAMPTZ [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '抓取到的行业动态（标题+原文链接）。同稿由 (instance_id, canonical_url) 与 (instance_id, dedup_key) 两条 UNIQUE 兜底，写入 ON CONFLICT DO NOTHING。不分区。'
}

Table industry_news_reads {
  "tenant_id" UUID [not null]
  "user_id" UUID [not null]
  "item_id" UUID [not null]
  "read_at" TIMESTAMPTZ [not null]
  indexes {
    (user_id, item_id) [pk]
  }
  Note: '用户对动态的已读记录；无记录即未读。复合主键 (user_id, item_id)；用户物理删除时 CASCADE。'
}

Table industry_news_sources {
  "id" UUID [pk, not null]
  "instance_id" VARCHAR [not null]
  "industry" VARCHAR(50) [not null]
  "code" VARCHAR(50) [not null]
  "name" VARCHAR(100) [not null]
  "url" TEXT [not null]
  "category" VARCHAR(100) [not null]
  "lang" VARCHAR(10) [not null]
  "strategy" VARCHAR(20) [not null]
  "parse_config" JSONB [not null]
  "is_active" BOOLEAN [not null]
  "last_fetched_at" TIMESTAMPTZ
  "last_success_at" TIMESTAMPTZ
  "error_count" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '行业动态源配置表，属于实例内的行业级资产（ADR 0001）。源属性与解析规则由仓库种子导入，管理端只读展示并可启停；抓取 worker 按启用源拉取标题+链接。'
}

Table intelligence_article_publications {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "article_id" UUID [not null]
  "article_created_at" TIMESTAMPTZ [not null]
  "status" VARCHAR(20) [not null]
  "has_summary" BOOLEAN [not null]
  "read_at" TIMESTAMPTZ
  "matched_by" VARCHAR(30)
  "subscription_id" UUID
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '文章向租户的发布与阅读状态表（tenant_id+article_id 唯一）；发布流程按订阅匹配写入，租户情报中心读取并更新已读/收藏/归档状态，本仓库读写。'
}

Table intelligence_articles {
  "id" UUID [not null]
  "source_id" UUID
  "title" VARCHAR(500) [not null]
  "url" TEXT
  "author" VARCHAR(200)
  "published_at" TIMESTAMPTZ
  "content_raw" TEXT
  "content_summary" TEXT
  "ai_category" VARCHAR(100)
  "ai_tags" JSONB [not null]
  "ai_relevance_score" NUMERIC(3,2)
  "ai_model_id" UUID
  "ai_usage_log_id" UUID
  "status" VARCHAR(20) [not null]
  "created_at" TIMESTAMPTZ [not null]
  indexes {
    (id, created_at) [pk]
  }
  Note: '行业情报文章表，按 created_at 月度 RANGE 分区；由 internal 端点 /intelligence/articles/publish（scope intelligence:publish）upsert 写入，随后按租户订阅匹配发布，本仓库读写。'
}

Table intelligence_sources {
  "id" UUID [pk, not null]
  "tenant_id" UUID
  "name" VARCHAR(200) [not null]
  "source_type" VARCHAR(20) [not null]
  "url" TEXT
  "fetch_config" JSONB [not null]
  "industry_tags" JSONB [not null]
  "is_active" BOOLEAN [not null]
  "last_fetched_at" TIMESTAMPTZ
  "error_count" INTEGER [not null]
  "deleted_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '行业情报源配置表（RSS/网站/手工三类），平台 Admin 维护与启停，tenant_id 为空即平台级源；本仓库读写，但定时自动抓取尚未实现（#49），文章目前靠人工经 internal 接口发布。'
}

Table intelligence_subscriptions {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "user_id" UUID [not null]
  "industry_tags" JSONB [not null]
  "min_relevance" NUMERIC(3,2) [not null]
  "notify_enabled" BOOLEAN [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户用户的情报订阅偏好表（每用户一条，PUT 全量覆盖）；发布文章时据此做行业标签交集与相关度阈值匹配，决定是否推送给该租户。本仓库读写。'
}

Table keyword_master {
  "id" UUID [pk, not null]
  "keyword" TEXT [not null]
  "keyword_normalized" TEXT [not null, unique]
  "created_at" TIMESTAMPTZ [not null]
  Note: '全平台去重的采集关键词主库，是外部采集与数据血缘的主控实体：lixiaoyun/tendata 原始表及 crawl_progress 以 keyword_master_id 单值挂靠，wmt/lixiaoyun 清洗层以 keyword_master_ids 数组物化血缘；现由外部采集侧写入（租户订阅表 tenant_keyword 已退役），admin 数据浏览页 JOIN 显示「搜索词」。'
}

Table lixiaoyun_api_clean_companies {
  "id" BIGINT [pk, not null]
  "pid" TEXT [not null, unique]
  "entname" TEXT
  "entname_eng" TEXT
  "legalperson" TEXT
  "uncid" TEXT
  "esdate" BIGINT
  "reg_cap" TEXT
  "regccap" TEXT
  "enttype" TEXT
  "entstatus" TEXT
  "geo_address" TEXT
  "dom" TEXT
  "province" INTEGER
  "city" INTEGER
  "district" INTEGER
  "industryphy_desc" TEXT
  "opscope" TEXT
  "scale" TEXT
  "annual_turnover" TEXT
  "official_website" TEXT
  "ent_introduction" TEXT
  "keyword_master_ids" UUID[]
  "source_record_ids" BIGINT[]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "location_code" TEXT
  "collected_at" TIMESTAMPTZ
  "enttype_code" TEXT
  "regno" TEXT
  "organizational_code" TEXT
  "opfrom" BIGINT
  "opto" BIGINT
  "regorg" TEXT
  "apprdate" BIGINT
  "revokedate" BIGINT
  "reg_province" INTEGER
  "reg_city" INTEGER
  "reg_district" INTEGER
  "oploc" TEXT
  "entstatus_code" INTEGER
  "industryphy" TEXT
  "secindustry" JSONB
  "secindustry_desc" JSONB
  "industry_l3" TEXT
  "industry_l3_desc" TEXT
  "industry_l4" TEXT
  "industry_l4_desc" TEXT
  "historyname_list" JSONB
  "legalperson_desc" TEXT
