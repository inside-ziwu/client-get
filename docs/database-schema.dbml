  "failed_login_count" INTEGER [not null]
  "locked_until" TIMESTAMPTZ
  "last_login_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "instance_id" VARCHAR [not null]
  Note: '平台侧管理员账号，admin 后台登录主体（JWT roles=platform_admin）。由 bootstrap 脚本创建，auth 服务维护登录与锁定状态。'
}

Table position_classification_categories {
  "id" UUID [pk, not null]
  "level_id" UUID [not null]
  "name" TEXT [not null]
  "display_name" TEXT [not null]
  "sort_order" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '职位类别表（平台全局，无租户隔离）：从属于职位等级，如 executive/purchasing，是匹配关键词的分组单元；admin 维护等级树时读写（迁移 0029）。'
}

Table position_classification_keywords {
  "id" UUID [pk, not null]
  "category_id" UUID [not null]
  "keyword" TEXT [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '职位匹配关键词表（平台全局）：对联系人 position 字符串做小写子串（LIKE）匹配，命中即把联系人归入所属类别与等级；admin 维护，v_tenant_contact_classified 视图实时使用。'
}

Table position_classification_levels {
  "id" UUID [pk, not null]
  "name" TEXT [not null]
  "display_name" TEXT [not null]
  "sort_order" INTEGER [not null]
  "is_sendable" BOOLEAN [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '职位等级表（平台全局）：联系人职位分类体系顶层，种子为 A 决策层/B 采购层/X 不投递；admin 维护，分类视图与发送计划收件人筛选读取（迁移 0029）。'
}

Table scoring_jobs {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "tenant_company_id" BIGINT [not null]
  "status" VARCHAR(20) [not null]
  "lease_id" UUID
  "lease_owner" VARCHAR(100)
  "lease_expires_at" TIMESTAMPTZ
  "attempt_count" INTEGER [not null]
  "last_error" TEXT
  "payload" JSONB [not null]
  "completed_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '评分任务队列表（租约认领设计，含 claim 索引与活跃任务唯一约束）。当前代码无生产者与消费者——评分已改为同步执行，仅租户硬删与数据迁移的清理路径触达此表。'
}

Table scoring_template_versions {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "template_id" UUID [not null]
  "version" INTEGER [not null]
  "dimensions" JSONB [not null]
  "grade_thresholds" JSONB [not null]
  "changed_by" UUID
  "change_reason" TEXT
  "created_at" TIMESTAMPTZ [not null]
  Note: '租户评分模板的版本快照：建租户、租户改分值、平台同步时各追加一行。company_scores 通过 template_version_id 固定引用评分时使用的版本。'
}

Table scoring_templates {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "source_platform_template_id" UUID
  "name" VARCHAR(200) [not null]
  "is_active" BOOLEAN [not null]
  "dimensions" JSONB [not null]
  "grade_thresholds" JSONB [not null]
  "version" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "industry" TEXT [not null]
  Note: '租户级评分模板：建租户时从平台行业模板复制（无则用内置默认），每租户仅一个激活。评分引擎按激活模板算分；租户端只能修改各条件的 score 值，平台模板更新会同步维度结构。'
}

Table sending_plan_recipients {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "plan_id" UUID [not null]
