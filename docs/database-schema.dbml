}

Table warmup_rule_levels {
  "id" UUID [pk, not null]
  "rule_id" UUID [not null]
  "level" INTEGER [not null]
  "daily_limit" INTEGER [not null]
  "min_stay_days" INTEGER [not null]
  "min_delivery_rate" NUMERIC(5,4) [not null]
  "max_bounce_rate" NUMERIC(5,4) [not null]
  "max_complaint_rate" NUMERIC(5,4) [not null]
  "created_at" TIMESTAMPTZ [not null]
  Note: '预热规则档位明细：每档的日发送上限与升档健康指标门槛；保存规则时整组重建，选档时把 daily_limit 复制进域名记录。'
}

Table warmup_rules {
  "id" UUID [pk, not null]
  "name" VARCHAR(100) [not null]
  "is_active" BOOLEAN [not null]
  "min_observation_emails" INTEGER [not null]
  "bounce_alert_rate" NUMERIC(5,4) [not null]
  "config" JSONB [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "instance_id" VARCHAR [not null]
  Note: '发信域名预热规则（平台级，按实例隔离）：定义观察样本与告警阈值，档位明细在 warmup_rule_levels；admin 配置，新建域名/租户时取激活规则定档。'
}

Table work_rule_sets {
  "id" UUID [pk, not null]
  "name" TEXT [not null]
  "work_days" INTEGER[] [not null]
  "time_segments" JSONB [not null]
  "is_default" BOOLEAN [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '工作时间规则集：定义可发送的星期与当地时段，国家经 rule_set_id 引用；admin 维护，worker 领取邮件时据此判定收件人当地是否可发。'
}

