  "trade_count" INTEGER
  "contacts_count" INTEGER
  "has_trade_data" BOOLEAN
  "aliases" TEXT[]
  "raw_payload" JSONB
  "detail_status" TEXT [not null]
  "detail_fetched_at" TIMESTAMPTZ
  "trade_status" TEXT [not null]
  "trade_fetched_at" TIMESTAMPTZ
  "contacts_status" TEXT [not null]
