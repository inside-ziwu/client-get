  "locked_at" TIMESTAMPTZ [not null]
  "appended_after_start" BOOLEAN [not null]
  "excluded_at" TIMESTAMPTZ
  "excluded_reason" VARCHAR(100)
  "created_at" TIMESTAMPTZ [not null]
  Note: '计划锁定的收件人白名单快照（公司+联系人），报名与发送以此为准；锁定与启动后追加时写入，(plan_id,tenant_contact_id) 唯一。'
}

Table sending_plans {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "created_by" UUID [not null]
  "name" VARCHAR(200) [not null]
  "description" TEXT
  "status" VARCHAR(20) [not null]
  "recipient_source" VARCHAR(20) [not null]
  "recipient_config" JSONB [not null]
  "send_strategy" JSONB [not null]
  "sender_name" VARCHAR(200)
  "sender_email" VARCHAR(255)
  "domain_id" UUID
  "total_recipients" INTEGER [not null]
  "sent_count" INTEGER [not null]
  "scheduled_at" TIMESTAMPTZ
  "started_at" TIMESTAMPTZ
  "completed_at" TIMESTAMPTZ
  "deleted_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户序列邮件发送计划主档：定义收件人圈选、发送策略、发件域名与发件身份，并汇总发送进度。租户 API 创建维护，发送 worker 读取 running 计划按域领取发送。'
}

Table sequence_enrollments {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "plan_id" UUID [not null]
  "plan_recipient_id" UUID [not null]
  "tenant_contact_id" BIGINT [not null]
  "current_step" INTEGER [not null]
  "status" VARCHAR(20) [not null]
  "enrolled_at" TIMESTAMPTZ [not null]
  "last_step_sent_at" TIMESTAMPTZ
  "next_step_due_at" TIMESTAMPTZ
  "completed_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "last_skip_reason" TEXT
  "last_skip_at" TIMESTAMPTZ
  "send_attempt_count" INTEGER [not null]
  Note: '联系人在某计划中的序列推进状态机（进行到第几步、下次何时发）。计划启动/追加时创建，worker 领取推进，webhook 回复/退信/退订时终止；(plan_id,tenant_contact_id) 唯一。'
}

Table sequence_steps {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "plan_id" UUID [not null]
  "step_number" INTEGER [not null]
  "template_id" UUID [not null]
  "delay_days" INTEGER [not null]
  "condition_type" VARCHAR(20) [not null]
  "use_ai_personalization" BOOLEAN [not null]
  "ai_instructions" TEXT
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '发送计划的序列步骤配置：第几步用哪个模板、延迟几天、按上一步反馈的触发条件。租户 API 维护，worker 按 enrollment.current_step 关联读取。'
}

Table tenant_ai_provider_configs {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "provider" VARCHAR(40) [not null]
  "api_key_encrypted" TEXT [not null]
  "encryption_key_version" INTEGER [not null]
  "configured_by_user_id" UUID
  "configured_by_platform_user_id" UUID
  "last_rotated_at" TIMESTAMPTZ [not null]
  "balance_status" VARCHAR(30) [not null]
  "balance_source" VARCHAR(20)
  "balance_amount" NUMERIC(12,4)
  "balance_currency" VARCHAR(10) [not null]
  "total_credits" NUMERIC(12,4)
  "total_usage" NUMERIC(12,4)
  "key_limit" NUMERIC(12,4)
  "key_limit_remaining" NUMERIC(12,4)
  "balance_checked_at" TIMESTAMPTZ
  "last_error_code" VARCHAR(100)
  "last_error_message" TEXT
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '每租户一行的 OpenRouter API Key 配置与余额缓存（60 秒 TTL）。租户设置页或平台管理员写入；AI 功能（邮件生成、情报摘要）调用前以 balance_status 作余额闸门。'
}

Table tenant_companies {
  "id" BIGINT [pk, not null]
  "tenant_id" UUID [not null]
  "clean_company_id" BIGINT [not null]
  "business_status" TEXT [not null]
  "data_status" TEXT [not null]
  "model_score" NUMERIC
  "score" NUMERIC
  "note" TEXT
  "tags" TEXT[]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  "score_adjustment" INTEGER [not null]
  Note: '租户私有客户池：把 waimaotong 清洗层公司按租户物化为池内记录，承载租户侧经营状态、数据完备度与人工修正。由 wmt_lineage_repair worker 按行业全池扇出及租户手动录入写入；客户池列表/详情、分组、发送计划读取。'
}

Table tenant_contacts {
  "id" BIGINT [pk, not null]
  "tenant_id" UUID [not null]
  "clean_contact_id" BIGINT [not null]
  "clean_company_id" BIGINT [not null]
  "contact_status" TEXT [not null]
  "is_sendable" BOOLEAN [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户联系人池：加组/建发送计划时按需从 waimaotong_clean_contacts 物化（ensure_contacts_from_wmt，仅取有邮箱者），记录租户侧投递状态。发送计划收件人筛选读取，邮件事件回传（退信/退订等）联动更新。'
}

Table tenant_scoring_weights {
  "id" UUID [pk, not null]
  "tenant_id" UUID [not null]
  "template_id" UUID [not null]
  "dimension" TEXT [not null]
  "weight" NUMERIC(5,2) [not null]
  "created_at" TIMESTAMPTZ [not null]
  "updated_at" TIMESTAMPTZ [not null]
  Note: '租户对评分模板各维度的自定义权重（C6），租户端 GET/PUT 接口按 模板+维度 批量 upsert。设计意图是评分时覆盖模板默认权重，当前评分引擎尚未读取此表。'
}

Table tenants {
  "id" UUID [pk, not null]
