{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@apps/admin", "dev", "--port", "3001"],
      "port": 3001,
      "cwd": "frontend"
    },
    {
      "name": "tenant",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@apps/tenant", "dev", "--port", "3001"],
      "port": 3001,
      "cwd": "frontend"
    }
  ]
}
