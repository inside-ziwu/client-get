{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "jsx": "preserve",
    "module": "ESNext",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/types": ["../../packages/shared-types/src"],
      "@shared/api": ["../../packages/shared-api/src"],
      "@shared/hooks": ["../../packages/shared-hooks/src"]
    }
  },
  "include": ["next-env.d.ts", "vite-env-shim.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
